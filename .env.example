# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Discord OAuth2 Credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Daytona.io API Key for Cloud VPS / Sandbox resources
DAYTONA_API_KEY=

# Email SMTP Credentials (e.g. Gmail App Password, Brevo, SendGrid)
# To deliver live verification codes directly to real recipient inboxes:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="gutiai <security@gutiai.com>"
# Optional: Resend API Key alternative
# RESEND_API_KEY=""
# Optional: Brevo API Key alternative
# BREVO_API_KEY=""
